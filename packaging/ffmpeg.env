# The FFmpeg build bundled with every release: the 8.1 series, GPL build,
# shared libraries. The exact build used is recorded in each release's
# licenses/FFMPEG-VERSION.txt.
FFMPEG_SERIES=8.1
FFMPEG_WINDOWS_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-win64-gpl-shared-8.1.zip
FFMPEG_LINUX_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-linux64-gpl-shared-8.1.tar.xz
