# The FFmpeg build bundled with every release: the 8.1 series, GPL build,
# shared libraries, pinned to one dated build of the build host and checked
# by SHA-256. `cargo xtask ffmpeg` (every build), packaging/windows/stage.ps1
# and packaging/linux/build-appimage.sh refuse an archive whose hash differs,
# so nothing unknown is ever built against or shipped. Each release records
# the build in its licenses/FFMPEG-VERSION.txt.
#
# Bumping the pin (see packaging/README.md): pick a newer dated release
# (autobuild-YYYY-MM-DD-HH-MM) of the build host, put its win64 and linux64
# "gpl-shared-8.1" asset URLs below, download both, and put their
# `sha256sum` here. The host deletes old dated releases after a while: when the
# pinned one is gone, `cargo xtask ffmpeg` and CI fail on the download, and the
# pin has to be bumped this way.
FFMPEG_SERIES=8.1
# Pinned: FFmpeg n8.1.3-35-gf1acb0a266, build host release autobuild-2026-11-17-12-40.
FFMPEG_WINDOWS_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-17-12-40/ffmpeg-n8.1.3-35-gf1acb0a266-win64-gpl-shared-8.1.zip
FFMPEG_WINDOWS_SHA256=6842d0691378278b78c15c0054ec999febed10665ce2d5bffe06af96617fce32
FFMPEG_LINUX_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-17-12-40/ffmpeg-n8.1.3-35-gf1acb0a266-linux64-gpl-shared-8.1.tar.xz
FFMPEG_LINUX_SHA256=2fb7a243213f46006a61a4e50b1de7b3586f5034b191547771a82c2c474c4789
